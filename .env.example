# ==============================================================================
# 🎌 Alpha Anime Bot — Environment Variables (.env)
# ==============================================================================

# Telegram Bot API Token (@BotFather orqali olingan)
BOT_TOKEN=8623305387:AAGh20c8_XXXXXXXXXXXXXX

# Asosiy adminlarning Telegram ID raqamlari (vergul bilan ajratilgan)
ADMIN_IDS=6444010235

# Adminlik huquqini olish uchun maxfiy parol (/claim_admin parol)
ADMIN_SECRET_KEY=anime2026

# Asosiy kanal username va havolasi
CHANNEL_USERNAME=@uzbekcha_animelar_alpha
CHANNEL_URL=https://t.me/uzbekcha_animelar_alpha
BOT_USERNAME=Alpha_animelar_bot

# Ma'lumotlar bazasi (standart SQLite yoki PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///bot_database.db

# 🍃 MongoDB Database sozlamalari (Docker yoki MongoDB Atlas)
# 1) Agar Docker orqali izolyatsiyalangan holda ishlatmoqchi bo'lsangiz:
MONGODB_URI=mongodb://alpha_admin:alpha_anime_2026_pass@localhost:27027/AlphaAnimeBotDB?authSource=admin
MONGODB_DB_NAME=AlphaAnimeBotDB

# Docker konfiguratsiya parametrlari (ixtiyoriy, standart qiymatlari bor)
DOCKER_MONGO_PORT=27027
MONGO_ROOT_USER=alpha_admin
MONGO_ROOT_PASSWORD=alpha_anime_2026_pass

# 2) Agar MongoDB Atlas (Bulutli) ishlatmoqchi bo'lsangiz:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Bot

# 24/7 Cloud Web Server sozlamalari
PORT=8080
HOST=0.0.0.0
WEB_SERVER_ENABLED=true

# ==============================================================================
